# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real key.

# Required for voice mode only. Text mode works without any key.
# Domestic: https://platform.minimaxi.com/
# Global:   https://platform.minimax.io/
MINIMAX_API_KEY=

# Required by the domestic endpoint. Found next to your API key in the console.
MINIMAX_GROUP_ID=

# "domestic" or "global"
MINIMAX_REGION=domestic
